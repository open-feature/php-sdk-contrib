parameters:
    tmpDir: ./build/cache/phpstan
    level: max
    paths:
        - ./src
        - ./tests
    excludePaths:
        - */tests/fixtures/*
        - */tests/*/fixtures/*
        # e2e bootstrap depends on testcontainers, a dev dep only installed for the opt-in e2e job
        - ./tests/e2e
        # TODO: Implement gRPC Completely
        - ./src/grpc (?)
    ignoreErrors:
        # assertInstanceOf()/assertNotNull() sanity checks in tests are flagged as always-true by phpstan-phpunit 2.x
        -
            identifier: method.alreadyNarrowedType
            path: tests/*
